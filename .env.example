# ==========================================
# MOUSA GLASS - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Server & Environment
PORT=3000
NODE_ENV=development

# 2. Database Connection (MySQL / TiDB / MariaDB)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL=mysql://root:password@localhost:3306/mousa_glass

# 3. Security & Session JWT Secret
# Generate a strong 32+ character random secret string
JWT_SECRET=super_secret_jwt_key_mousa_glass_luxury_2026_noir

# 4. Admin Privileges Configuration
# Comma-separated list of emails that automatically get admin role on login
ADMIN_EMAILS=admin@mousaglass.com,owner@mousaglass.com

# 5. OAuth & Client Application (Optional / If using external SSO)
VITE_APP_ID=mousa-glass-app
OWNER_OPEN_ID=
OAUTH_SERVER_URL=

# 6. Payment Information Note
# Payments are handled exclusively upon courier delivery:
# - Cash on Delivery (COD)
# - InstaPay with the Courier
# No Stripe secret or external gateway keys are required.
